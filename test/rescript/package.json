        "extract": "../../_build/default/bin/Extract.exe --allow-duplicates src"
    },
    "dependencies": {
        "rescript": "12.0.0-rc.3",
        "@rescript/react": "0.14.0",
        "jest": "^29.0.0",
        "minimist": "^1.2.5",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-intl": "7.1.10"
    }
}